      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pegar"
          }
        }
      }
    },
    "Quit" : {
      "comment" : "Footer button that quits the app.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salir"
          }
        }
      }
    },
    "Quit Unlatch" : {
      "comment" : "Help text and accessibility label of the footer's Quit button, and the title of the main menu's Quit item. Keep the app name as is.",
