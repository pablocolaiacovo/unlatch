            "state" : "translated",
            "value" : "Desbloqueado"
          }
        }
      }
    },
    "Unlocking…" : {
      "comment" : "Shown with a spinner while the passwords are being checked.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueando…"
          }
        }
      }
    },
    "Update Available" : {
      "comment" : "Footer button, shown only when a new version exists, and its accessibility label.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualización disponible"
          }
        }
      }
    },
    "Update Available…" : {
      "comment" : "Menu item shown instead of “Check for Updates…” when a new version is available.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualización disponible…"
          }
        }
      }
    },
    "Update available" : {
      "comment" : "Accessibility value of the menu bar icon and the More button when a new version is available.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualización disponible"
          }
        }
      }
    },
    "Version %@" : {
      "comment" : "Disabled menu item showing the app version, for example “Version 1.2.0”. The value is a version number, or “dev” in a development build.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versión %@"
          }
        }
      }
    },
    "Version %@ (%@)" : {
      "comment" : "Disabled menu item showing the app version and build number, for example “Version 1.2.0 (42)”.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Version %1$@ (%2$@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versión %1$@ (%2$@)"
          }
        }
      }
    },
    "We’ll try the same password on all of them. Anything that doesn’t match gets skipped." : {
      "comment" : "Password step subtitle when several files are protected: one password is tried on all of them.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probaremos la misma contraseña en todos. Los que no coincidan se omitirán."
          }
        }
      }
    },
    "Where should the unlocked file go?" : {
      "comment" : "Destination step title when one file will be saved.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde quieres guardar el archivo desbloqueado?"
          }
        }
      }
    },
    "Where should the unlocked files go?" : {
      "comment" : "Destination step title when several files will be saved.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dónde quieres guardar los archivos desbloqueados?"
          }
        }
      }
    },
    "next to the original" : {
      "comment" : "Hint under the “Same folder, add -unlocked” option before a sample path is known.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "junto al original"
          }
        }
      }
    },
    "opens a save panel" : {
      "comment" : "Hint under the “Choose folder…” option before a folder has been chosen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "abre un panel para guardar"
          }
        }
      }
    },
    "overwrites the original" : {
      "comment" : "Hint under the “Same folder, replace original” option before a sample path is known.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "reemplaza el original"
          }
        }
      }
    }
  },
  "version" : "1.0"
