          "stringUnit" : {
            "state" : "translated",
            "value" : "Salir de Unlatch"
          }
        }
      }
    },
    "Redo" : {
      "comment" : "Edit menu item (hidden main menu).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehacer"
          }
        }
      }
    },
    "Removes the open password so the file opens without one. Nothing leaves your Mac." : {
      "comment" : "Idle step: privacy caption under the Choose PDFs button.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita la contraseña de apertura para que el archivo se abra sin ella. Nada sale de tu Mac."
          }
        }
      }
    },
    "Same folder, add “-unlocked”" : {
      "comment" : "Destination radio option. Saves next to the original with a suffix. “-unlocked” is the literal text added to the file name and is not translated.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misma carpeta, agregar “-unlocked”"
          }
        }
      }
    },
    "Same folder, replace original" : {
      "comment" : "Destination radio option. Overwrites the original file with the unlocked copy.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misma carpeta, reemplazar el original"
          }
        }
      }
    },
    "Save" : {
      "comment" : "Button on the destination step: write the unlocked copies.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar"
          }
        }
      }
    },
    "Saved" : {
      "comment" : "Done step title when one file was saved.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado"
          }
        }
      }
    },
    "See the available update" : {
      "comment" : "Help text of the footer's Update Available button.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ver la actualización disponible"
          }
        }
      }
    },
    "Select All" : {
      "comment" : "Edit menu item (hidden main menu).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccionar todo"
          }
        }
      }
    },
    "Show" : {
      "comment" : "Password step: small button that reveals the typed password. Same length as Hide.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar"
          }
        }
      }
    },
    "Show in Finder" : {
      "comment" : "Button on the done step: reveal the saved files in Finder.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar en el Finder"
          }
        }
      }
    },
    "That password didn’t work. Try again." : {
      "comment" : "Password step: inline error after none of the PDFs opened with the password.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa contraseña no funcionó. Inténtalo de nuevo."
          }
        }
      }
    },
    "This PDF needs a password" : {
      "comment" : "Password step title when a single file is password protected.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PDF necesita una contraseña"
          }
        }
      }
    },
    "Turned off in System Settings > General > Login Items. Check to open Login Items and allow Unlatch." : {
      "comment" : "Tooltip of the Open at Login menu item when the user switched Unlatch off in the macOS login items settings. Do not name the System Settings pane in translations: it has different names across Spanish-speaking regions.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado en los ajustes de inicio de sesión de macOS. Marca la opción para abrirlos y permitir Unlatch."
          }
        }
      }
    },
    "Undo" : {
      "comment" : "Edit menu item (hidden main menu).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshacer"
          }
        }
      }
    },
    "Unlatch couldn't read the selected files." : {
      "comment" : "Error text macOS shows when the Unlock with Unlatch Services entry was used but the files could not be read. Keep the app name as is.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlatch no pudo leer los archivos seleccionados."
          }
        }
      }
    },
    "Unlatch opens when you log in" : {
      "comment" : "Tooltip of the Open at Login menu item when it is on.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlatch se abre al iniciar sesión"
          }
        }
      }
    },
    "Unlatch: update available" : {
      "comment" : "Tooltip of the menu bar icon when a new version is available. “Unlatch” is the app name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlatch: actualización disponible"
          }
        }
      }
    },
    "Unlock" : {
      "comment" : "Button on the password step: try the password and unlock the PDFs.",
