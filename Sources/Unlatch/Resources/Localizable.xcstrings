        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cifrar — copiado tal cual"
          }
        }
      }
    },
    "Not encrypted — nothing to unlock" : {
      "comment" : "File row note. The PDF has no protection at all, so there is nothing to unlock.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cifrar — nada que desbloquear"
          }
        }
      }
    },
    "Open Unlatch when you log in" : {
      "comment" : "Tooltip of the Open at Login menu item when it is off.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir Unlatch al iniciar sesión"
          }
        }
      }
    },
    "Open at Login" : {
      "comment" : "Ellipsis menu: checkable item that makes Unlatch start when the user logs in.",
