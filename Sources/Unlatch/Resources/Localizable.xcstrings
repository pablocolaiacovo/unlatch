{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "A file name or path shown as is. Do not translate.",
      "shouldTranslate" : false
    },
    "%@/ (originals replaced)" : {
      "comment" : "Done step summary when a batch overwrote its originals. The value is a folder path followed by a slash; move it if the language needs.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@/ (originales reemplazados)"
          }
        }
      }
    },
    "%lld files in %lld folders" : {
      "comment" : "Done step summary for a batch saved into several folders: file count, then folder count. Both values are always 2 or more.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld files in %2$lld folders"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld archivos en %2$lld carpetas"
          }
        }
      }
    },
    "%lld files need a password" : {
      "comment" : "Password step title when several files are password protected. The value is always 2 or more.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld archivos necesitan una contraseña"
          }
        }
      }
    },
    "%lld files saved" : {
      "comment" : "Done step title when several files were saved. The value is always 2 or more.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld archivos guardados"
          }
        }
      }
    },
    "%lld saved, %lld failed" : {
      "comment" : "Done step title for a partial batch: how many files were saved, then how many failed. Either value can be 1, so each needs its own singular and plural form.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld saved, %2$lld failed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@saved@, %#@failed@"
          },
          "substitutions" : {
            "failed" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg falló"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg fallaron"
                    }
                  }
                }
              }
            },
            "saved" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg guardado"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg guardados"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Available when Unlatch runs from an app bundle" : {
      "comment" : "Tooltip of the disabled Open at Login menu item when the app runs outside an app bundle, for example during development.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible cuando Unlatch se ejecuta desde una App"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Button: abandon this batch and return to the start (password and destination steps).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar"
          }
        }
      }
    },
    "Check Automatically" : {
      "comment" : "Checkable menu item: whether the app looks for new versions by itself.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificar automáticamente"
          }
        }
      }
    },
    "Check for Updates…" : {
      "comment" : "Menu item that checks for a new version now.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar actualizaciones…"
          }
        }
      }
    },
    "Choose" : {
      "comment" : "Confirm button of the folder picker opened by Choose folder…",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegir"
          }
        }
      }
    },
    "Choose PDFs…" : {
      "comment" : "Idle step: the big button that opens the file picker.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegir PDF…"
          }
        }
      }
    },
    "Choose folder…" : {
      "comment" : "Destination radio option. Opens a panel to pick a folder.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegir carpeta…"
          }
        }
      }
    },
    "Copied as-is — opens without a password" : {
      "comment" : "File row note after saving a PDF that only had permission restrictions: it was copied unchanged and already opens without a password.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiado tal cual — se abre sin contraseña"
          }
        }
      }
    },
    "Copy" : {
      "comment" : "Edit menu item (hidden main menu).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar"
          }
        }
      }
    },
    "Couldn’t be copied — not saved" : {
      "comment" : "File row note. Copying a file that needed no unlocking failed, so it was not saved.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo copiar — no se guardó"
          }
        }
      }
    },
    "Couldn’t be read — not saved" : {
      "comment" : "File row note. The file could not be read, so it was not saved.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer — no se guardó"
          }
        }
      }
    },
    "Couldn’t save — all %lld files failed" : {
      "comment" : "Done step title when every file of a batch failed. The value is always 2 or more.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar — fallaron los %lld archivos"
          }
        }
      }
    },
    "Couldn’t save — nothing was written" : {
      "comment" : "Done step title when no file could be saved.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar — no se escribió nada"
          }
        }
      }
    },
    "Couldn’t save — the file failed" : {
      "comment" : "Done step title when the single file failed to save.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar — falló el archivo"
          }
        }
      }
    },
    "Couldn’t write the file — not saved" : {
      "comment" : "File row note. Writing the unlocked copy failed, so nothing was saved for this file.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo escribir el archivo — no se guardó"
          }
        }
      }
    },
    "Cut" : {
      "comment" : "Edit menu item (hidden main menu).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cortar"
          }
        }
      }
    },
    "Desktop" : {
      "comment" : "Destination radio option. Saves to the Desktop folder.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escritorio"
          }
        }
      }
    },
    "Done" : {
      "comment" : "Button on the done step: close the summary and return to the start.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listo"
          }
        }
      }
    },
    "Edit" : {
      "comment" : "Title of the Edit menu in the hidden main menu. Never shown, but reachable through Accessibility.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edición"
          }
        }
      }
    },
    "Hide" : {
      "comment" : "Password step: small button that masks the typed password again.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar"
          }
        }
      }
    },
    "More" : {
      "comment" : "Help text and accessibility label of the ellipsis menu button in the footer.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más"
          }
        }
      }
    },
    "No open password — permissions only" : {
      "comment" : "File row note. The PDF opens without a password and only restricts permissions such as printing or copying.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin contraseña de apertura — solo permisos"
          }
        }
      }
    },
    "Not a readable PDF — skipped" : {
      "comment" : "File row note. The file is not a PDF the app can read, so it is skipped.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es un PDF legible — se omitió"
          }
        }
      }
    },
    "Not encrypted — copied as-is" : {
      "comment" : "File row note after saving a PDF that had no protection: it was copied unchanged.",
