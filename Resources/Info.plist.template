<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.pablocolaiacovo.unlatch</string>
    <key>CFBundleName</key>
    <string>Unlatch</string>
    <!-- The languages the app ships (Sources/Unlatch/Resources/Localizable.xcstrings).
         macOS picks the app's language from this list: without it the app is
         English even on a Spanish Mac, and System Settings offers no per-app
         language. Keep it in step with the catalog (InfoPlistTemplateTests
         checks both). -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>es</string>
    </array>
    <key>CFBundleDisplayName</key>
    <string>Unlatch</string>
    <key>CFBundleExecutable</key>
    <string>Unlatch</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <!-- Substituted by Scripts/package-app.sh from `git describe --tags`. Never
         hardcode a version here: the git tag is the only source of truth
         (see RELEASING.md). -->
    <key>CFBundleShortVersionString</key>
    <string>__SHORT_VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD_VERSION__</string>
    <!-- Matches platforms: [.macOS(.v14)] in Package.swift. -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Menu-bar-only: no Dock icon, no app switcher entry. Belt-and-braces
         with the runtime NSApp.setActivationPolicy(.accessory) call in
         AppDelegate.swift, since the two are not always
         equivalent inside a real bundle. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Sparkle appcast, served over https from GitHub Pages. -->
    <key>SUFeedURL</key>
    <string>https://pablocolaiacovo.github.io/unlatch/appcast.xml</string>
    <!-- Public EdDSA key; the private half lives only in the release secret. -->
    <key>SUPublicEDKey</key>
    <string>c1nkY1mfZROc+woQU0n8BKTxwcySykispaZaMbshWy0=</string>
    <!-- Updates are offered, never installed without the user accepting. -->
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
    <!-- Scheduled checks once a day; Sparkle's own prompt still asks first. -->
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <!-- Finder hand-off (issue #14, Design/finder-quick-action.md). A Services
         entry, not an app extension: no sandbox, no entitlements, no nested code.
         NSMessage must match FinderHandoff's @objc selector
         unlockPDFs(_:userData:error:); InfoPlistTemplateTests checks it.
         NSRequiredContext must be present, even empty, or macOS registers the
         service but never shows it.
         The menu title below is the English text and the lookup key: macOS
         translates it from Resources/<lang>.lproj/ServicesMenu.strings in the
         app bundle (not from the resource bundle Bundle.module uses).
         Scripts/package-app.sh copies Resources/es.lproj there;
         InfoPlistTemplateTests checks the keys match. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Unlock with Unlatch</string>
            </dict>
            <key>NSMessage</key>
            <string>unlockPDFs</string>
            <key>NSPortName</key>
            <string>Unlatch</string>
            <key>NSSendFileTypes</key>
            <array>
                <string>com.adobe.pdf</string>
            </array>
            <key>NSRequiredContext</key>
            <dict/>
        </dict>
    </array>
    <!-- Lists Unlatch under Finder's Open With for PDFs and routes `open -a`
         and Open With to application(_:open:). Alternate rank: Unlatch is a
         secondary handler and never becomes the default PDF viewer. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>PDF Document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.adobe.pdf</string>
            </array>
        </dict>
    </array>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Pablo Colaiacovo</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
